# Transaction Data
transactions <- list(
  c("Milk", "Bread", "Butter"),
  c("Bread", "Butter"),
  c("Milk", "Bread"),
  c("Milk", "Butter"),
  c("Bread", "Butter", "Eggs"),
  c("Milk", "Bread", "Butter"),
  c("Milk", "Eggs"),
  c("Bread", "Eggs"),
  c("Milk", "Bread", "Eggs"),
  c("Bread", "Butter")
)

# Total number of transactions
n <- length(transactions)

# Get all unique items
items <- unique(unlist(transactions))

# Calculate frequency of each item
freq <- sapply(
  items,
  function(item) {
    sum(
      sapply(
        transactions,
        function(x) item %in% x
      )
    )
  }
)

# Calculate support
support <- freq / n

# Bar Plot
barplot(
  support,
  names.arg = items,
  main = "Support of Items",
  ylab = "Support"
)

# Pie Chart
pie(
  support,
  labels = items,
  main = "Item Support Distribution"
)
