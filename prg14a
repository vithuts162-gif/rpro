xlab = "Petal Length",  ylab = "Petal Width",  main = "K-Means Clustering on Iris Dataset") 
# Plot Centroids 
spoints(  kmeans_model$centers[,3],  kmeans_model$centers[,4],  col = 1:3,  pch = 8, 
cex = 3)
