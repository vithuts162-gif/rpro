data(iris) 
# Remove Species column 
iris_data <- iris[,1:4] 
# Apply K-Means Clustering 
set.seed(123) 
kmeans_model <- kmeans(  iris_data,  centers = 3,  nstart = 25) 
# Display Results 
cat("Cluster Assignment:\n") 
print(kmeans_model$cluster) 
cat("\nCluster Centers:\n") 
print(kmeans_model$centers) 
# Visualize Clusters 
