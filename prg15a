# Transaction Data
transactions <- list(
  c("Milk", "Bread", "Butter"),
  c("Bread", "Butter"),
  c("Milk", "Bread"),
  c("Milk", "Butter"),
  c("Bread", "Butter", "Eggs"),
  c("Milk", "Bread", "Butter"),
  c("Milk", "Eggs"),
  c("Bread", "Eggs"),
  c("Milk", "Bread", "Eggs"),
  c("Bread", "Butter")
)

# Total number of transactions
n <- length(transactions)

# Support(Milk)
milk_count <- sum(
  sapply(transactions, function(x) "Milk" %in% x)
)

# Support(Bread)
bread_count <- sum(
  sapply(transactions, function(x) "Bread" %in% x)
)

# Support(Milk and Bread)
milk_bread <- sum(
  sapply(transactions,
         function(x) all(c("Milk", "Bread") %in% x))
)

# Calculate Support
support <- milk_bread / n

# Calculate Confidence
confidence <- milk_bread / milk_count

# Calculate Lift
lift <- confidence / (bread_count / n)

# Display Results
cat("Association Rule\n")
cat("Milk -> Bread\n")
cat("Support =", support, "\n")
cat("Confidence =", confidence, "\n")
cat("Lift =", lift, "\n")
