# Load Dataset 
data(iris) 
# Display First Six Records 
head(iris) 
# Remove Target Variable 
iris_data <- iris[,1:4] 
# Calculate Distance Matrix 
distance_matrix <- dist(  iris_data,  method = "euclidean") 
# Display Dsistance Matrix 
print(distance_matrix) 
